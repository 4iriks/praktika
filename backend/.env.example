APP_ENV=development
APP_NAME=PyAnswer API
APP_VERSION=0.5.0
DEBUG=true

DATABASE_URL=postgresql+asyncpg://pyanswer:<database-password>@localhost:5432/pyanswer
TEST_DATABASE_URL=postgresql+asyncpg://pyanswer_test:<test-database-password>@localhost:55432/pyanswer_test
FRONTEND_ORIGINS=["http://localhost:5173"]

SESSION_COOKIE_NAME=pyanswer_session
CSRF_COOKIE_NAME=pyanswer_csrf
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=<set-outside-git>
BOOTSTRAP_ADMIN_NAME=Администратор
SEED_DEMO_DATA=false

STACK_EXCHANGE_SITE=ru.stackoverflow
STACK_EXCHANGE_TAG=python
STACK_EXCHANGE_TARGET_DOCUMENTS=25000
STACKEXCHANGE_API_BASE_URL=https://api.stackexchange.com/2.3
STACKEXCHANGE_KEY=
STACKEXCHANGE_QUESTION_FILTER=withbody
STACKEXCHANGE_ANSWER_FILTER=withbody
STACKEXCHANGE_PAGE_SIZE=100
STACKEXCHANGE_REQUESTS_PER_SECOND=3
STACKEXCHANGE_CONNECT_TIMEOUT_SECONDS=5
STACKEXCHANGE_READ_TIMEOUT_SECONDS=20
STACKEXCHANGE_WRITE_TIMEOUT_SECONDS=10
STACKEXCHANGE_POOL_TIMEOUT_SECONDS=5
STACKEXCHANGE_MAX_RETRIES=4
STACKEXCHANGE_QUOTA_RESERVE=100
STACKEXCHANGE_MAX_RESPONSE_BYTES=8000000
STACKEXCHANGE_MAX_PAGES=1000
STACKEXCHANGE_INCREMENTAL_OVERLAP_SECONDS=86400
STACKEXCHANGE_USER_AGENT=PyAnswer/0.5 StackExchange ingestion worker

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_ATTEMPTS=5
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
