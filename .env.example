POSTGRES_DB=pyanswer
POSTGRES_USER=pyanswer
POSTGRES_PASSWORD=<set-a-local-database-password>
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080

APP_ENV=development
APP_NAME=PyAnswer API
APP_VERSION=0.7.0
DEBUG=false
FRONTEND_ORIGINS=["http://localhost:8080"]

SESSION_COOKIE_NAME=pyanswer_session
CSRF_COOKIE_NAME=pyanswer_csrf
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=<set-outside-git>
BOOTSTRAP_ADMIN_NAME=Администратор
SEED_DEMO_DATA=false

STACK_EXCHANGE_SITE=ru.stackoverflow
STACK_EXCHANGE_TAG=python
STACK_EXCHANGE_TARGET_DOCUMENTS=25000

# Stack Exchange API key is optional. Keep it empty unless it is supplied locally.
STACKEXCHANGE_API_BASE_URL=https://api.stackexchange.com/2.3
STACKEXCHANGE_KEY=
STACKEXCHANGE_QUESTION_FILTER=withbody
STACKEXCHANGE_ANSWER_FILTER=withbody
STACKEXCHANGE_PAGE_SIZE=100
STACKEXCHANGE_REQUESTS_PER_SECOND=3
STACKEXCHANGE_CONNECT_TIMEOUT_SECONDS=5
STACKEXCHANGE_READ_TIMEOUT_SECONDS=20
STACKEXCHANGE_WRITE_TIMEOUT_SECONDS=10
STACKEXCHANGE_POOL_TIMEOUT_SECONDS=5
STACKEXCHANGE_MAX_RETRIES=4
STACKEXCHANGE_QUOTA_RESERVE=100
STACKEXCHANGE_MAX_RESPONSE_BYTES=8000000
STACKEXCHANGE_MAX_PAGES=1000
STACKEXCHANGE_INCREMENTAL_OVERLAP_SECONDS=86400
STACKEXCHANGE_USER_AGENT=PyAnswer/0.5 StackExchange ingestion worker

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_ATTEMPTS=5
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_SERVER_VERSION=1.18.2
QDRANT_CLIENT_VERSION=1.18.0
QDRANT_ALIAS=pyanswer_chunks_current
QDRANT_COLLECTION_PREFIX=pyanswer_chunks
QDRANT_TIMEOUT_SECONDS=30
QDRANT_MAX_RETRIES=3

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DOCUMENT_MAX_INPUT_TOKENS=512
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=3
EMBEDDING_KEEP_ALIVE=5m

SPARSE_PROVIDER=qdrant_bm25
SPARSE_MODEL=qdrant/bm25
INDEX_SCHEMA_VERSION=6.1
INDEX_EMBED_BATCH_SIZE=16
INDEX_QDRANT_UPSERT_BATCH_SIZE=64
INDEX_JOB_MAX_ATTEMPTS=5
INDEX_RETAIN_RETIRED_COUNT=1
INDEX_AUTO_CLEANUP=false
AUTO_ENQUEUE_DOCUMENT_REINDEX=true

RERANKER_BASE_URL=http://reranker:8001
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_MODEL_REVISION=e1775d95f8cf4625eea7879c6edb34beae6c42af
RERANKER_DEVICE=cpu
RERANKER_REQUIRED=false

LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://ollama:11434
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=180
LLM_KEEP_ALIVE=5m
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_QUEUE_LIMIT=4
LLM_QUEUE_TIMEOUT_SECONDS=15
LLM_THINK=false

RAG_SEARCH_MODE=hybrid
RAG_CANDIDATE_LIMIT=80
RAG_RERANK_LIMIT=8
RERANKER_TOP_N=8
RERANKER_MAX_LENGTH=768
ACCEPTANCE_API_BASE_URL=http://backend:8000/api
ACCEPTANCE_DEMO_PASSWORD=
RAG_SOURCES_LIMIT=5
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_CONTEXT_TOKEN_BUDGET=5000
RAG_MIN_RERANKER_SCORE=0.25
RAG_MIN_SOURCE_COUNT=1
RAG_MAX_SOURCE_COUNT=5

PROJECT_DISK_WARNING_GB=27
PROJECT_DISK_CRITICAL_GB=30
PROJECT_DISK_LIMIT_GB=35
BACKUP_RETENTION_COUNT=3
