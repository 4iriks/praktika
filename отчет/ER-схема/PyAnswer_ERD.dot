digraph PyAnswer_ERD {
  graph [rankdir=LR, bgcolor="white", splines=ortho, concentrate=false, label="ER-диаграмма базы данных информационно-поисковой системы PyAnswer\nGit cc88219998c0ee34a7d7fafd744b5bf79e7865a5 · Alembic 20260716_0006 · 2026-07-16", labelloc=t, fontsize=22];
  node [shape=plain, fontname="Arial"];
  edge [color="#64748b", fontname="Arial", fontsize=9, arrowsize=.7];
  subgraph "cluster_Auth" { label="Auth"; color="#94a3b8";
    "roles" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">character varying(16) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">character varying(80) [NN]</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text [NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_roles_role_code_values: CHECK (code::text = ANY (ARRAY[&#x27;USER&#x27;::character varying, &#x27;EDITOR&#x27;::character varying, &#x27;ADMIN&#x27;::character varying]::text[]))</FONT></TD></TR></TABLE>>];
    "permissions" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>permissions</B></TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">character varying(80) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text [NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR></TABLE>>];
    "role_permissions" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>role_permissions</B></TD></TR><TR><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">uuid [PK,FK,NN]</TD></TR><TR><TD ALIGN="LEFT">permission_id</TD><TD ALIGN="LEFT">uuid [PK,FK,NN]</TD></TR></TABLE>>];
    "users" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">uuid [FK,NN]</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">character varying(120) [NN]</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">character varying(320) [NN]</TD></TR><TR><TD ALIGN="LEFT">normalized_email</TD><TD ALIGN="LEFT">character varying(320) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">text [NN]</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">account_version</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">registered_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">last_active_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">blocked_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">blocked_by</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">block_reason</TD><TD ALIGN="LEFT">character varying(500) [NULL]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_users_user_account_version_positive: CHECK (account_version &gt;= 1)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_users_user_status_values: CHECK (status::text = ANY (ARRAY[&#x27;ACTIVE&#x27;::character varying, &#x27;BLOCKED&#x27;::character varying]::text[]))</FONT></TD></TR></TABLE>>];
    "sessions" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>sessions</B></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid [FK,NN]</TD></TR><TR><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">character varying(64) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">csrf_token_hash</TD><TD ALIGN="LEFT">character varying(64) [NN]</TD></TR><TR><TD ALIGN="LEFT">account_version</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">remember_me</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">last_seen_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">revoked_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT">inet [NULL]</TD></TR><TR><TD ALIGN="LEFT">user_agent</TD><TD ALIGN="LEFT">character varying(500) [NULL]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR></TABLE>>];
    "user_preferences" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>user_preferences</B></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid [PK,FK,NN]</TD></TR><TR><TD ALIGN="LEFT">default_search_mode</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">default_search_view</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">default_page_size</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">auto_expand_scores</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">confirm_external_links</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_user_preferences_preference_page_size_values: CHECK (default_page_size = ANY (ARRAY[10, 20, 50]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_user_preferences_preference_search_mode_values: CHECK (default_search_mode::text = ANY (ARRAY[&#x27;bm25&#x27;::character varying, &#x27;vector&#x27;::character varying, &#x27;hybrid&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_user_preferences_preference_search_view_values: CHECK (default_search_view::text = ANY (ARRAY[&#x27;documents&#x27;::character varying, &#x27;answer&#x27;::character varying]::text[]))</FONT></TD></TR></TABLE>>];
  }
  subgraph "cluster_Corpus" { label="Corpus"; color="#94a3b8";
    "sources" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dcfce7" COLSPAN="2"><B>sources</B></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">character varying(200) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">character varying(40) [NN]</TD></TR><TR><TD ALIGN="LEFT">base_url</TD><TD ALIGN="LEFT">character varying(2000) [NN]</TD></TR><TR><TD ALIGN="LEFT">site</TD><TD ALIGN="LEFT">character varying(120) [NN]</TD></TR><TR><TD ALIGN="LEFT">tag</TD><TD ALIGN="LEFT">character varying(100) [NN]</TD></TR><TR><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">target_documents</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">max_additional_answers</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">page_size</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">documents_count</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">last_sync_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">last_successful_sync_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">last_check_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">rate_limit_remaining</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">rate_limit_total</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">quota_reset_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">current_job_id</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">last_error</TD><TD ALIGN="LEFT">character varying(1000) [NULL]</TD></TR><TR><TD ALIGN="LEFT">api_key_configured</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT">rate_limit_updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_sources_source_answers_range: CHECK (max_additional_answers &gt;= 0 AND max_additional_answers &lt;= 3)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_sources_source_page_size_range: CHECK (page_size &gt;= 1 AND page_size &lt;= 100)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_sources_source_status_values: CHECK (status::text = ANY (ARRAY[&#x27;IDLE&#x27;::character varying, &#x27;CHECKING&#x27;::character varying, &#x27;SYNCING&#x27;::character varying, &#x27;PAUSED&#x27;::character varying, &#x27;ERROR&#x27;::character varying, &#x27;DISABLED&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_sources_source_target_range: CHECK (target_documents &gt;= 5000 AND target_documents &lt;= 100000)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_sources_source_type_values: CHECK (type::text = &#x27;STACK_EXCHANGE&#x27;::text)</FONT></TD></TR></TABLE>>];
    "documents" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dcfce7" COLSPAN="2"><B>documents</B></TD></TR><TR><TD ALIGN="LEFT">source_id</TD><TD ALIGN="LEFT">uuid [FK,UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">external_id</TD><TD ALIGN="LEFT">character varying(120) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">source_url</TD><TD ALIGN="LEFT">character varying(2000) [NN]</TD></TR><TR><TD ALIGN="LEFT">original_title</TD><TD ALIGN="LEFT">character varying(500) [NN]</TD></TR><TR><TD ALIGN="LEFT">normalized_title</TD><TD ALIGN="LEFT">character varying(500) [NN]</TD></TR><TR><TD ALIGN="LEFT">question_text</TD><TD ALIGN="LEFT">text [NN]</TD></TR><TR><TD ALIGN="LEFT">question_html</TD><TD ALIGN="LEFT">text [NULL]</TD></TR><TR><TD ALIGN="LEFT">author_name</TD><TD ALIGN="LEFT">character varying(200) [NN]</TD></TR><TR><TD ALIGN="LEFT">published_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">source_updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">score</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">views_count</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">answers_count</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">accepted_answer_external_id</TD><TD ALIGN="LEFT">character varying(120) [NULL]</TD></TR><TR><TD ALIGN="LEFT">has_code</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">bm25_status</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">vector_status</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">chunks_count</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">content_hash</TD><TD ALIGN="LEFT">character varying(128) [NN]</TD></TR><TR><TD ALIGN="LEFT">editorial_note</TD><TD ALIGN="LEFT">character varying(2000) [NN]</TD></TR><TR><TD ALIGN="LEFT">hidden_reason</TD><TD ALIGN="LEFT">character varying(1000) [NULL]</TD></TR><TR><TD ALIGN="LEFT">failure_reason</TD><TD ALIGN="LEFT">character varying(1000) [NULL]</TD></TR><TR><TD ALIGN="LEFT">last_indexed_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">last_synced_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">last_edited_by</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">last_edited_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT">author_profile_url</TD><TD ALIGN="LEFT">character varying(2000) [NULL]</TD></TR><TR><TD ALIGN="LEFT">content_license</TD><TD ALIGN="LEFT">character varying(120) [NULL]</TD></TR><TR><TD ALIGN="LEFT">metadata_hash</TD><TD ALIGN="LEFT">character varying(128) [NULL]</TD></TR><TR><TD ALIGN="LEFT">canonical_text</TD><TD ALIGN="LEFT">text [NULL]</TD></TR><TR><TD ALIGN="LEFT">processing_status</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">deduplication_status</TD><TD ALIGN="LEFT">character varying(24) [NN]</TD></TR><TR><TD ALIGN="LEFT">duplicate_of_document_id</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">last_seen_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">processing_error</TD><TD ALIGN="LEFT">character varying(1000) [NULL]</TD></TR><TR><TD ALIGN="LEFT">selected_answers_count</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_documents_document_bm25_status_values: CHECK (bm25_status::text = ANY (ARRAY[&#x27;READY&#x27;::character varying, &#x27;PENDING&#x27;::character varying, &#x27;FAILED&#x27;::character varying, &#x27;NOT_INDEXED&#x27;::character varying, &#x27;OUTDATED&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_documents_document_deduplication_status_values: CHECK (deduplication_status::text = ANY (ARRAY[&#x27;UNIQUE&#x27;::character varying, &#x27;EXACT_DUPLICATE&#x27;::character varying, &#x27;POSSIBLE_DUPLICATE&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_documents_document_processing_status_values: CHECK (processing_status::text = ANY (ARRAY[&#x27;RAW&#x27;::character varying, &#x27;CLEANING&#x27;::character varying, &#x27;CLEANED&#x27;::character varying, &#x27;CHUNKING&#x27;::character varying, &#x27;CHUNKED&#x27;::character varying, &#x27;FAILED&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_documents_document_selected_answers_non_negative: CHECK (selected_answers_count &gt;= 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_documents_document_status_values: CHECK (status::text = ANY (ARRAY[&#x27;ACTIVE&#x27;::character varying, &#x27;HIDDEN&#x27;::character varying, &#x27;PENDING&#x27;::character varying, &#x27;FAILED&#x27;::character varying, &#x27;OUTDATED&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_documents_document_vector_status_values: CHECK (vector_status::text = ANY (ARRAY[&#x27;READY&#x27;::character varying, &#x27;PENDING&#x27;::character varying, &#x27;FAILED&#x27;::character varying, &#x27;NOT_INDEXED&#x27;::character varying, &#x27;OUTDATED&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_documents_document_version_positive: CHECK (version &gt;= 1)</FONT></TD></TR></TABLE>>];
    "answers" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dcfce7" COLSPAN="2"><B>answers</B></TD></TR><TR><TD ALIGN="LEFT">document_id</TD><TD ALIGN="LEFT">uuid [FK,UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">external_id</TD><TD ALIGN="LEFT">character varying(120) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">author_name</TD><TD ALIGN="LEFT">character varying(200) [NN]</TD></TR><TR><TD ALIGN="LEFT">body_text</TD><TD ALIGN="LEFT">text [NN]</TD></TR><TR><TD ALIGN="LEFT">body_html</TD><TD ALIGN="LEFT">text [NULL]</TD></TR><TR><TD ALIGN="LEFT">score</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">is_accepted</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">published_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">source_updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT">author_profile_url</TD><TD ALIGN="LEFT">character varying(2000) [NULL]</TD></TR><TR><TD ALIGN="LEFT">sanitized_html</TD><TD ALIGN="LEFT">text [NULL]</TD></TR><TR><TD ALIGN="LEFT">body_hash</TD><TD ALIGN="LEFT">character varying(64) [NN]</TD></TR><TR><TD ALIGN="LEFT">last_seen_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">selected_for_corpus</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">selection_rank</TD><TD ALIGN="LEFT">integer [NULL]</TD></TR><TR><TD ALIGN="LEFT">source_missing</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">content_license</TD><TD ALIGN="LEFT">character varying(120) [NULL]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_answers_answer_selection_rank_positive: CHECK (selection_rank IS NULL OR selection_rank &gt;= 1)</FONT></TD></TR></TABLE>>];
    "tags" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dcfce7" COLSPAN="2"><B>tags</B></TD></TR><TR><TD ALIGN="LEFT">normalized_name</TD><TD ALIGN="LEFT">character varying(100) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">character varying(100) [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR></TABLE>>];
    "document_tags" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dcfce7" COLSPAN="2"><B>document_tags</B></TD></TR><TR><TD ALIGN="LEFT">document_id</TD><TD ALIGN="LEFT">uuid [PK,FK,NN]</TD></TR><TR><TD ALIGN="LEFT">tag_id</TD><TD ALIGN="LEFT">uuid [PK,FK,NN]</TD></TR><TR><TD ALIGN="LEFT">is_managed</TD><TD ALIGN="LEFT">boolean [PK,NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR></TABLE>>];
    "document_chunks" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dcfce7" COLSPAN="2"><B>document_chunks</B></TD></TR><TR><TD ALIGN="LEFT">chunk_key</TD><TD ALIGN="LEFT">character varying(64) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">document_id</TD><TD ALIGN="LEFT">uuid [FK,UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">document_version</TD><TD ALIGN="LEFT">integer [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">ordinal</TD><TD ALIGN="LEFT">integer [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">section_type</TD><TD ALIGN="LEFT">character varying(24) [NN]</TD></TR><TR><TD ALIGN="LEFT">answer_id</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">text [NN]</TD></TR><TR><TD ALIGN="LEFT">contextual_text</TD><TD ALIGN="LEFT">text [NN]</TD></TR><TR><TD ALIGN="LEFT">content_hash</TD><TD ALIGN="LEFT">character varying(64) [NN]</TD></TR><TR><TD ALIGN="LEFT">token_count</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">character_count</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">has_code</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">language</TD><TD ALIGN="LEFT">character varying(40) [NULL]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_document_chunks_document_chunk_character_count_non_negative: CHECK (character_count &gt;= 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_document_chunks_document_chunk_ordinal_non_negative: CHECK (ordinal &gt;= 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_document_chunks_document_chunk_section_type_values: CHECK (section_type::text = ANY (ARRAY[&#x27;QUESTION&#x27;::character varying, &#x27;ACCEPTED_ANSWER&#x27;::character varying, &#x27;ANSWER&#x27;::character varying, &#x27;MIXED&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_document_chunks_document_chunk_text_not_empty: CHECK (length(text) &gt; 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_document_chunks_document_chunk_token_count_non_negative: CHECK (token_count &gt;= 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_document_chunks_document_chunk_version_positive: CHECK (document_version &gt;= 1)</FONT></TD></TR></TABLE>>];
