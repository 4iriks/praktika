    "rag_responses" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fae8ff" COLSPAN="2"><B>rag_responses</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT">character varying(80) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">query</TD><TD ALIGN="LEFT">character varying(1000) [NN]</TD></TR><TR><TD ALIGN="LEFT">search_mode</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">answer_text</TD><TD ALIGN="LEFT">text [NN]</TD></TR><TR><TD ALIGN="LEFT">model</TD><TD ALIGN="LEFT">character varying(200) [NN]</TD></TR><TR><TD ALIGN="LEFT">model_version</TD><TD ALIGN="LEFT">character varying(200) [NULL]</TD></TR><TR><TD ALIGN="LEFT">prompt_version</TD><TD ALIGN="LEFT">character varying(40) [NN]</TD></TR><TR><TD ALIGN="LEFT">prompt_hash</TD><TD ALIGN="LEFT">character varying(64) [NN]</TD></TR><TR><TD ALIGN="LEFT">index_version_id</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">confidence</TD><TD ALIGN="LEFT">double precision [NN]</TD></TR><TR><TD ALIGN="LEFT">confidence_label</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">insufficient_context</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">citation_validation_passed</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">source_count</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">search_ms</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">reranker_ms</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">generation_ms</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">total_ms</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">prompt_tokens</TD><TD ALIGN="LEFT">integer [NULL]</TD></TR><TR><TD ALIGN="LEFT">output_tokens</TD><TD ALIGN="LEFT">integer [NULL]</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">error_code</TD><TD ALIGN="LEFT">character varying(80) [NULL]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_rag_responses_rag_response_confidence_label_values: CHECK (confidence_label::text = ANY (ARRAY[&#x27;LOW&#x27;::character varying, &#x27;MEDIUM&#x27;::character varying, &#x27;HIGH&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_rag_responses_rag_response_confidence_range: CHECK (confidence &gt;= 0::double precision AND confidence &lt;= 1::double precision)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_rag_responses_rag_response_search_mode_values: CHECK (search_mode::text = ANY (ARRAY[&#x27;bm25&#x27;::character varying, &#x27;vector&#x27;::character varying, &#x27;hybrid&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_rag_responses_rag_response_source_count_non_negative: CHECK (source_count &gt;= 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_rag_responses_rag_response_status_values: CHECK (status::text = ANY (ARRAY[&#x27;GENERATING&#x27;::character varying, &#x27;COMPLETED&#x27;::character varying, &#x27;FAILED&#x27;::character varying, &#x27;CANCELLED&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_rag_responses_rag_response_timings_non_negative: CHECK (search_ms &gt;= 0 AND reranker_ms &gt;= 0 AND generation_ms &gt;= 0 AND total_ms &gt;= 0)</FONT></TD></TR></TABLE>>];
    "rag_response_sources" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fae8ff" COLSPAN="2"><B>rag_response_sources</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT">response_id</TD><TD ALIGN="LEFT">uuid [FK,UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">chunk_id</TD><TD ALIGN="LEFT">uuid [FK,UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">document_id</TD><TD ALIGN="LEFT">uuid [FK,NN]</TD></TR><TR><TD ALIGN="LEFT">citation_index</TD><TD ALIGN="LEFT">integer [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">rank</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">bm25_score</TD><TD ALIGN="LEFT">double precision [NULL]</TD></TR><TR><TD ALIGN="LEFT">vector_score</TD><TD ALIGN="LEFT">double precision [NULL]</TD></TR><TR><TD ALIGN="LEFT">fusion_score</TD><TD ALIGN="LEFT">double precision [NN]</TD></TR><TR><TD ALIGN="LEFT">reranker_score</TD><TD ALIGN="LEFT">double precision [NULL]</TD></TR><TR><TD ALIGN="LEFT">source_url</TD><TD ALIGN="LEFT">character varying(2000) [NN]</TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">character varying(500) [NN]</TD></TR><TR><TD ALIGN="LEFT">passage_hash</TD><TD ALIGN="LEFT">character varying(64) [NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_rag_response_sources_rag_source_citation_positive: CHECK (citation_index &gt;= 1)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_rag_response_sources_rag_source_rank_positive: CHECK (rank &gt;= 1)</FONT></TD></TR></TABLE>>];
    "feedback" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fae8ff" COLSPAN="2"><B>feedback</B></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid [FK,UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">response_id</TD><TD ALIGN="LEFT">character varying(120) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">character varying(40) [NULL]</TD></TR><TR><TD ALIGN="LEFT">question</TD><TD ALIGN="LEFT">character varying(1000) [NN]</TD></TR><TR><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">character varying(1000) [NULL]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT">rag_response_id</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_feedback_feedback_value_values: CHECK (value::text = ANY (ARRAY[&#x27;positive&#x27;::character varying, &#x27;negative&#x27;::character varying]::text[]))</FONT></TD></TR></TABLE>>];
  }
  subgraph "cluster_Jobs___Audit" { label="Jobs / Audit"; color="#94a3b8";
    "jobs" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fee2e2" COLSPAN="2"><B>jobs</B></TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">character varying(32) [UQ,NN]</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">stage</TD><TD ALIGN="LEFT">character varying(32) [NN]</TD></TR><TR><TD ALIGN="LEFT">progress</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">processed_items</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">total_items</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">source_id</TD><TD ALIGN="LEFT">uuid [FK,UQ,NULL]</TD></TR><TR><TD ALIGN="LEFT">document_id</TD><TD ALIGN="LEFT">uuid [FK,UQ,NULL]</TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">retry_of_job_id</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">cancellable</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT">jsonb [NN]</TD></TR><TR><TD ALIGN="LEFT">error_code</TD><TD ALIGN="LEFT">character varying(80) [NULL]</TD></TR><TR><TD ALIGN="LEFT">error_message</TD><TD ALIGN="LEFT">character varying(1000) [NULL]</TD></TR><TR><TD ALIGN="LEFT">planned_duration_ms</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">finished_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT">claimed_by</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">claimed_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">lease_expires_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">heartbeat_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">attempt</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">max_attempts</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">next_attempt_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">cancellation_requested_at</TD><TD ALIGN="LEFT">timestamp with time zone [NULL]</TD></TR><TR><TD ALIGN="LEFT">checkpoint</TD><TD ALIGN="LEFT">jsonb [NN]</TD></TR><TR><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT">jsonb [NN]</TD></TR><TR><TD ALIGN="LEFT">request_count</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">bytes_received</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_jobs_job_attempt_non_negative: CHECK (attempt &gt;= 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_jobs_job_attempt_within_limit: CHECK (attempt &lt;= max_attempts)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_jobs_job_bytes_received_non_negative: CHECK (bytes_received &gt;= 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_jobs_job_max_attempts_positive: CHECK (max_attempts &gt;= 1)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_jobs_job_progress_range: CHECK (progress &gt;= 0 AND progress &lt;= 100)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_jobs_job_request_count_non_negative: CHECK (request_count &gt;= 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_jobs_job_stage_values: CHECK (stage::text = ANY (ARRAY[&#x27;PREPARING&#x27;::character varying, &#x27;FETCHING_QUESTIONS&#x27;::character varying, &#x27;FETCHING_ANSWERS&#x27;::character varying, &#x27;WAITING_BACKOFF&#x27;::character varying, &#x27;PROCESSING&#x27;::character varying, &#x27;CRAWLING&#x27;::character varying, &#x27;CLEANING&#x27;::character varying, &#x27;DEDUPLICATING&#x27;::character varying, &#x27;CHUNKING&#x27;::character varying, &#x27;EMBEDDING&#x27;::character varying, &#x27;INDEXING_BM25&#x27;::character varying, &#x27;INDEXING_VECTOR&#x27;::character varying, &#x27;FINALIZING&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_jobs_job_status_values: CHECK (status::text = ANY (ARRAY[&#x27;QUEUED&#x27;::character varying, &#x27;RUNNING&#x27;::character varying, &#x27;COMPLETED&#x27;::character varying, &#x27;FAILED&#x27;::character varying, &#x27;CANCELLED&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_jobs_job_type_values: CHECK (type::text = ANY (ARRAY[&#x27;SOURCE_SYNC&#x27;::character varying, &#x27;DOCUMENT_REPROCESS&#x27;::character varying, &#x27;DOCUMENT_REINDEX&#x27;::character varying, &#x27;FULL_REINDEX&#x27;::character varying, &#x27;HEALTH_CHECK&#x27;::character varying, &#x27;SEARCH_INDEX_VALIDATE&#x27;::character varying, &#x27;SEARCH_INDEX_CLEANUP&#x27;::character varying]::text[]))</FONT></TD></TR></TABLE>>];
    "job_events" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fee2e2" COLSPAN="2"><B>job_events</B></TD></TR><TR><TD ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT">uuid [FK,NN]</TD></TR><TR><TD ALIGN="LEFT">level</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">stage</TD><TD ALIGN="LEFT">character varying(32) [NN]</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">character varying(80) [NN]</TD></TR><TR><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">character varying(1000) [NN]</TD></TR><TR><TD ALIGN="LEFT">metrics</TD><TD ALIGN="LEFT">jsonb [NN]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_job_events_job_event_code_not_empty: CHECK (length(code::text) &gt; 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_job_events_job_event_level_values: CHECK (level::text = ANY (ARRAY[&#x27;DEBUG&#x27;::character varying, &#x27;INFO&#x27;::character varying, &#x27;WARNING&#x27;::character varying, &#x27;ERROR&#x27;::character varying]::text[]))</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_job_events_job_event_message_not_empty: CHECK (length(message::text) &gt; 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_job_events_job_event_stage_values: CHECK (stage::text = ANY (ARRAY[&#x27;PREPARING&#x27;::character varying, &#x27;FETCHING_QUESTIONS&#x27;::character varying, &#x27;FETCHING_ANSWERS&#x27;::character varying, &#x27;WAITING_BACKOFF&#x27;::character varying, &#x27;PROCESSING&#x27;::character varying, &#x27;CRAWLING&#x27;::character varying, &#x27;CLEANING&#x27;::character varying, &#x27;DEDUPLICATING&#x27;::character varying, &#x27;CHUNKING&#x27;::character varying, &#x27;EMBEDDING&#x27;::character varying, &#x27;INDEXING_BM25&#x27;::character varying, &#x27;INDEXING_VECTOR&#x27;::character varying, &#x27;FINALIZING&#x27;::character varying]::text[]))</FONT></TD></TR></TABLE>>];
    "audit_events" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fee2e2" COLSPAN="2"><B>audit_events</B></TD></TR><TR><TD ALIGN="LEFT">actor_user_id</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">actor_name</TD><TD ALIGN="LEFT">character varying(200) [NN]</TD></TR><TR><TD ALIGN="LEFT">actor_role</TD><TD ALIGN="LEFT">character varying(16) [NULL]</TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">character varying(80) [NN]</TD></TR><TR><TD ALIGN="LEFT">entity_type</TD><TD ALIGN="LEFT">character varying(40) [NN]</TD></TR><TR><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT">character varying(120) [NN]</TD></TR><TR><TD ALIGN="LEFT">entity_label</TD><TD ALIGN="LEFT">character varying(500) [NN]</TD></TR><TR><TD ALIGN="LEFT">outcome</TD><TD ALIGN="LEFT">character varying(16) [NN]</TD></TR><TR><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT">inet [NULL]</TD></TR><TR><TD ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT">character varying(80) [NN]</TD></TR><TR><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">character varying(80) [NULL]</TD></TR><TR><TD ALIGN="LEFT">summary</TD><TD ALIGN="LEFT">character varying(1000) [NN]</TD></TR><TR><TD ALIGN="LEFT">before</TD><TD ALIGN="LEFT">jsonb [NULL]</TD></TR><TR><TD ALIGN="LEFT">after</TD><TD ALIGN="LEFT">jsonb [NULL]</TD></TR><TR><TD ALIGN="LEFT">metadata</TD><TD ALIGN="LEFT">jsonb [NULL]</TD></TR><TR><TD ALIGN="LEFT">error_code</TD><TD ALIGN="LEFT">character varying(80) [NULL]</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid [PK,NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_audit_events_audit_outcome_values: CHECK (outcome::text = ANY (ARRAY[&#x27;SUCCESS&#x27;::character varying, &#x27;FAILURE&#x27;::character varying]::text[]))</FONT></TD></TR></TABLE>>];
    "system_settings" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fee2e2" COLSPAN="2"><B>system_settings</B></TD></TR><TR><TD ALIGN="LEFT">singleton_id</TD><TD ALIGN="LEFT">integer [PK,NN]</TD></TR><TR><TD ALIGN="LEFT">search_candidates_limit</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">reranker_limit</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">rag_sources_limit</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">default_minimum_confidence</TD><TD ALIGN="LEFT">double precision [NN]</TD></TR><TR><TD ALIGN="LEFT">allow_guest_search</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">allow_guest_rag</TD><TD ALIGN="LEFT">boolean [NN]</TD></TR><TR><TD ALIGN="LEFT">history_retention_days</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">audit_retention_days</TD><TD ALIGN="LEFT">integer [NN]</TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT">uuid [FK,NULL]</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp with time zone [NN]</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_system_settings_settings_audit_retention_range: CHECK (audit_retention_days &gt;= 30 AND audit_retention_days &lt;= 3650)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_system_settings_settings_candidates_range: CHECK (search_candidates_limit &gt;= 10 AND search_candidates_limit &lt;= 1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_system_settings_settings_confidence_range: CHECK (default_minimum_confidence &gt;= 0::double precision AND default_minimum_confidence &lt;= 1::double precision)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_system_settings_settings_history_retention_range: CHECK (history_retention_days &gt;= 1 AND history_retention_days &lt;= 3650)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_system_settings_settings_rag_sources_range: CHECK (rag_sources_limit &gt;= 1 AND rag_sources_limit &lt;= 20)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_system_settings_settings_reranker_range: CHECK (reranker_limit &gt;= 1 AND reranker_limit &lt;= 100)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8">CK ck_system_settings_system_settings_singleton: CHECK (singleton_id = 1)</FONT></TD></TR></TABLE>>];
